    {
      "parameters": {
        "jsCode": "const users = $input.first().json.users || $input.first().json || [];\nconst targetEmail = $('Webhook Update Password').first().json.body.email;\nconst providedUserId = $('Webhook Update Password').first().json.body.user_id;\n\n// Si el payload ya tiene un user_id valido que no sea un md5 (los md5 tienen 32 chars, los UUID tienen guiones)\nif (providedUserId && providedUserId.includes('-')) {\n  return [{ json: { found: true, id: providedUserId } }];\n}\n\nif (!targetEmail) {\n  return [{ json: { found: false, error: 'Email no proporcionado' } }];\n}\n\n// Buscar por email en la lista de usuarios\nconst user = users.find(u => u.email && u.email.toLowerCase() === targetEmail.toLowerCase());\n\nif (user) {\n  return [{ json: { found: true, id: user.id } }];\n}\n\nreturn [{ json: { found: false, error: 'Usuario no encontrado en Supabase Auth' } }];"
      },
