          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify(Object.fromEntries(Object.entries($('Webhook Update Profile').first().json.body).filter(([k,v]) => !['user_id', 'user_email', 'action'].includes(k)))) }}",
        "options": { "response": { "response": { "neverError": false } } }
      },
      "id": "supabase-patch-profile",
