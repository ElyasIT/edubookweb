        "url": "https://vibsrorignwbcwqbuten.supabase.co/rest/v1/perfiles",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "sb_publishable_uawYeXSNpPQHOA-RR2JGXg_EBvbXhhz" },
            { "name": "Authorization", "value": "Bearer sb_publishable_uawYeXSNpPQHOA-RR2JGXg_EBvbXhhz" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify(Object.fromEntries(Object.entries(Object.assign({}, $('Webhook Update Profile').first().json.body, { id: $('Webhook Update Profile').first().json.body.user_id, rol: 'explorador' })).filter(([k,v]) => !['user_id', 'user_email', 'action'].includes(k)))) }}",
        "options": { "response": { "response": { "neverError": false } } }
      },
      "id": "supabase-post-profile",
      "name": "Supabase POST Perfil",
      "type": "n8n-nodes-base.httpRequest",
