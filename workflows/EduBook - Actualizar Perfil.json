    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://vibsrorignwbcwqbuten.supabase.co/rest/v1/perfiles?id=eq.' + $('Webhook Update Profile').first().json.body.user_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "sb_publishable_uawYeXSNpPQHOA-RR2JGXg_EBvbXhhz" },
