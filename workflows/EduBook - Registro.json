    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nconst nombre      = (body.nombre      || '').trim();\nconst email       = (body.email       || '').trim().toLowerCase();\nconst password    = (body.password    || '');\nconst universidad = (body.universidad || '').trim();\nconst rol         = (body.rol         || 'explorador').trim();\n\nlet error = null;\nif (!nombre || !email || !password) error = 'Faltan campos obligatorios';\nelse if (password.length < 8) error = 'La contraseña debe tener al menos 8 caracteres';\n\nif (error) {\n  return [{ json: { has_error: true, error_msg: error } }];\n}\n\nreturn [{ json: { has_error: false, nombre, email, password, universidad, rol } }];"
      },
