    {
      "parameters": {
        "jsCode": "// Procesar la respuesta de Supabase y devolver mensajes en español\nconst res = $input.first().json;\n\n// Supabase puede devolver el error en distintos campos según la versión\nconst rawError = res.error || res.error_code || '';\nconst rawMsg   = res.message || res.error_description || res.msg || '';\n\n// Detectar email ya registrado\nconst emailYaExiste = \n  rawError.toString().toLowerCase().includes('already') ||\n  rawError.toString().toLowerCase().includes('exists') ||\n  rawMsg.toString().toLowerCase().includes('already') ||\n  rawMsg.toString().toLowerCase().includes('already registered') ||\n  rawMsg.toString().toLowerCase().includes('user already') ||\n  res.code === 422;\n\nif (emailYaExiste) {\n  return [{ json: {\n    has_error: true,\n    error_msg: 'Este correo ya está registrado. Inicia sesión con tu cuenta existente.'\n  }}];\n}\n\n// Otro tipo de error\nif (rawError || (!res.user && !res.id)) {\n  const msg = rawMsg || rawError || 'No se pudo crear la cuenta. Inténtalo de nuevo.';\n  return [{ json: { has_error: true, error_msg: msg } }];\n}\n\n// Registro correcto\nreturn [{ json: {\n  has_error: false,\n  user_id: (res.user || res).id || '',\n  email:   (res.user || res).email || ''\n}}];"
      },
