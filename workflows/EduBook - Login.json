    {
      "parameters": {
        "jsCode": "const authUser = $('Validar Respuesta Login').first().json;\nconst dbPerfil = $json.id ? $json : {};\n\nreturn [{ json: {\n  login_ok: true,\n  access_token: authUser.access_token,\n  expires_in: authUser.expires_in,\n  user_id: authUser.user_id,\n  user_email: authUser.user_email,\n  nombre: dbPerfil.nombre || authUser.nombre,\n  universidad: dbPerfil.universidad || authUser.universidad,\n  rol: dbPerfil.rol || authUser.rol,\n  telefono: dbPerfil.telefono || '',\n  id_estudiante: dbPerfil.id_estudiante || '',\n  fecha_nacimiento: dbPerfil.fecha_nacimiento || '',\n  avatar: dbPerfil.avatar || ''\n}}];"
      },
      "id": "merge-perfil",
      "name": "Merge Perfil",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 448, 0 ]
    },
