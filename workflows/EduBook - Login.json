        "responseBody": "={\n  \"status\": \"ok\",\n  \"access_token\": \"{{ $json.access_token }}\",\n  \"expires_in\": {{ $json.expires_in }},\n  \"user\": {\n    \"id\":          \"{{ $json.user_id }}\",\n    \"email\":       \"{{ $json.user_email }}\",\n    \"nombre\":      \"{{ $json.nombre }}\",\n    \"universidad\": \"{{ $json.universidad }}\",\n    \"rol\":         \"{{ $json.rol }}\",\n    \"telefono\":    \"{{ $json.telefono }}\",\n    \"id_estudiante\": \"{{ $json.id_estudiante }}\",\n    \"fecha_nacimiento\": \"{{ $json.fecha_nacimiento }}\",\n    \"avatar\":      \"{{ $json.avatar }}\"\n  }\n}",
