    {
      "parameters": {
        "jsCode": "// Validar la respuesta de Supabase de forma robusta\nconst res = $input.first().json;\n\n// Supabase puede indicar error en distintos campos según la versión\nconst hasErrorField  = !!res.error;         // 'invalid_grant'\nconst hasErrorCode   = !!res.error_code;    // 'invalid_credentials'\nconst hasMessage     = !!res.message;       // 'Invalid login credentials'\nconst hasAccessToken = !!res.access_token;  // Si no hay token, no se autenticó\nconst httpCode       = res.$responseCode || 0;\n\n// Credenciales incorrectas: hay error O falta el access_token\nconst loginFailed = hasErrorField || hasErrorCode || !hasAccessToken;\n\nif (loginFailed) {\n  return [{ json: { login_ok: false } }];\n}\n\n// Login correcto → extraer perfil de user_metadata\nconst user = res.user || {};\nconst meta = user.user_metadata || {};\n\nconst nombre      = meta.nombre      || meta.full_name || '';\nconst universidad = meta.universidad || meta.university || '';\nconst rol         = (meta.rol || 'explorador').toLowerCase().trim();\n\nreturn [{ json: {\n  login_ok:     true,\n  access_token: res.access_token || '',\n  expires_in:   res.expires_in   || 3600,\n  user_id:      user.id          || '',\n  user_email:   user.email       || '',\n  nombre,\n  universidad,\n  rol\n}}];"
      },
